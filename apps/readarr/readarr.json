{
  "category": "Media",
  "version": 1,
  "name": "Readarr",
  "port": 8787,
  "description": "Readarr is an ebook and audiobook collection manager for Usenet and BitTorrent users.",
  "website": "https://readarr.com",
  "dockerImage": "docker.io/linuxserver/readarr:develop",
  "dockerPorts": [],
  "dockerNetworkMode": "bridge",
  "dockerVolumes": [
    "$REQUIRED:/config",
    "$REQUIRED:/books",
    "$REQUIRED:/downloads"
  ],
  "dockerEnvironment": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "$TIMEZONE"
  }
}
