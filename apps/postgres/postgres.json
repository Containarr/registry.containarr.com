{
  "category": "Database",
  "version": 1,
  "name": "PostgreSQL",
  "port": 5432,
  "description": "PostgreSQL with VectorChord and pgvector extensions for Immich and general database workloads.",
  "website": "https://www.postgresql.org",
  "dockerImage": "ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0",
  "dockerPorts": [],
  "dockerNetworkMode": "bridge",
  "dockerVolumes": {
    "postgres-data": "/var/lib/postgresql/data"
  },
  "dockerEnvironment": {
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": "$REQUIRED",
    "POSTGRES_DB": "immich",
    "POSTGRES_INITDB_ARGS": "--data-checksums"
  }
}
