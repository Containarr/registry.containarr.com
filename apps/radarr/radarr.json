{
  "category": "Media",
  "version": 1,
  "name": "Radarr",
  "port": 7878,
  "description": "Radarr is a movie collection manager for Usenet and BitTorrent users.",
  "website": "https://radarr.video",
  "dockerImage": "docker.io/linuxserver/radarr:latest",
  "dockerPorts": [],
  "dockerNetworkMode": "bridge",
  "dockerVolumes": [
    "radarr-config:/config",
    "$REQUIRED:/movies",
    "$REQUIRED:/downloads"
  ],
  "dockerEnvironment": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "$TIMEZONE"
  }
}
